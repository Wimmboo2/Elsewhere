<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Elsewhere" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Elsewhere.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_arrow</item>
        <item name="postSplashScreenTheme">@style/Theme.Elsewhere</item>
    </style>
</resources>
